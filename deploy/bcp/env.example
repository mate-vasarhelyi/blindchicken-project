# Copy to ~/.config/bcp-openproject.env and chmod 600 it.
OPENPROJECT_HOSTNAME=project.blindchicken.productions
DATA_ROOT=/mnt/Pool/apps/openproject-data
APP_PORT=8096
SECRET_KEY_BASE=replace-with-at-least-64-random-hex-characters
OPENPROJECT_SEED__ADMIN__USER__PASSWORD=replace-with-at-least-32-random-alphanumeric-characters

# Optional SMTP. If set, include EMAIL_DELIVERY_METHOD=smtp and SMTP_ADDRESS.
# EMAIL_DELIVERY_METHOD=smtp
# SMTP_ADDRESS=smtp.example.net
# SMTP_PORT=587
# SMTP_DOMAIN=example.net
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_SSL=false
# SMTP_USER_NAME=openproject@example.net
# SMTP_PASSWORD=replace-me
